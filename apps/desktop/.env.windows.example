# Copy to .env.windows (Git ignored). Use UTF-8 and quote secrets containing # or spaces.
# Credential file paths may be absolute or relative to apps/desktop. Values are not shell-expanded.
HARNOVA_DESKTOP_APP_ID=io.github.aero123421.harnova
HARNOVA_DESKTOP_AUTO_UPDATE_ENV=test
HARNOVA_DOWNLOAD_TEST_ORIGIN=
# Required for production: configure your own HTTPS origin; upstream origins are rejected.
HARNOVA_DOWNLOAD_PROD_ORIGIN=
# Required for test releases: 32 lowercase hexadecimal characters from a secure random generator.
# Generate once per release batch; retain it for retries and versions testing upgrades within that batch.
HARNOVA_DOWNLOAD_TEST_RELEASE_ID=

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
# HARNOVA_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com


# The selected mandatory-update origin is required, including unsigned and preparation builds.
HARNOVA_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
HARNOVA_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
# Set approved login origins for test builds; omit allowedAuthOrigins for production.
# Optional polling and fallback-page options belong in the same JSON value.
# The fallback-page allowlist defaults to the selected service origin.
HARNOVA_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'

HARNOVA_DESKTOP_WINDOWS_CER_FILE=
HARNOVA_DESKTOP_WINDOWS_SIGNTOOL=
HARNOVA_DESKTOP_WINDOWS_KEY_CONTAINER=
HARNOVA_DESKTOP_WINDOWS_TOKEN_PIN=

# Optional absolute, private local directory; defaults to %USERPROFILE%\.harnova-desktop-signing\signature-cache\v1.
# HARNOVA_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=C:\Users\build\.harnova-desktop-signing\signature-cache\v1

# Cache-hit restore and verification workers (1-8). Hardware signing remains serial.
HARNOVA_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4

# Optional upload configuration; packaging does not require these credentials.
# HARNOVA_DOWNLOAD_TEST_COS_BUCKET=
# HARNOVA_DOWNLOAD_TEST_COS_SECRET_ID=
# HARNOVA_DOWNLOAD_TEST_COS_SECRET_KEY=
# HARNOVA_DOWNLOAD_PROD_COS_BUCKET=
# HARNOVA_DOWNLOAD_PROD_COS_SECRET_ID=
# HARNOVA_DOWNLOAD_PROD_COS_SECRET_KEY=
